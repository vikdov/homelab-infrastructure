# ==============================================================================
# Ansible Proxmox Dynamic Inventory Configuration
# Copy this file to `.env` and fill in your actual environment parameters:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# Proxmox VE API Connection
# ------------------------------------------------------------------------------
# URL of your Proxmox VE host or cluster endpoint (including port 8006)
export PROXMOX_URL="https://192.168.1.254:8006"

# Proxmox Realm User (e.g., user@pve, user@pam)
export PROXMOX_USER="ansible@pve"

# ------------------------------------------------------------------------------
# Authentication (API Token - RECOMMENDED)
# ------------------------------------------------------------------------------
# The Token ID created in Proxmox under Datacenter -> API Tokens
export PROXMOX_TOKEN_ID="api"

# The secret UUID associated with the API Token ID
export PROXMOX_TOKEN_SECRET="00000000-0000-0000-0000-000000000000" # only the UUID
