---
# Copy to vault.yml, fill in, then:  ansible-vault encrypt inventory/host_vars/net/vault.yml
vault_pihole_web_password: "change-me-to-a-long-random-password" # min. 12 chars: openssl rand -base64 24
# Tailscale admin -> Settings -> Keys: single-use, pre-approved, short expiry, tagged (tag:subnet-router)
vault_tailscale_authkey: "REPLACE-WITH-TAILSCALE-AUTH-KEY"
