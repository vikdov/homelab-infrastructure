---
# Copy to vault.yml, fill in, then:  ansible-vault encrypt inventory/host_vars/net/vault.yml
vault_pihole_web_password: "change-me-to-a-long-password"   # min. 12 characters
# Tailscale admin -> Settings -> Keys: single-use, pre-approved, short expiry, tagged (e.g. tag:subnet-router)
vault_tailscale_authkey: "tskey-auth-xxxxxxxxxxxx"
