# {{ ansible_managed }}
POSTGRES_HOST=db
POSTGRES_DB=nextcloud
POSTGRES_USER=nextcloud
POSTGRES_PASSWORD={{ apps_pw.nextcloud_db }}
REDIS_HOST=redis
# NEXTCLOUD_TRUSTED_DOMAINS only takes effect on the very first install; later domain changes need
# `occ config:system:set trusted_domains`. The proxy/overwrite settings below apply on every start.
NEXTCLOUD_TRUSTED_DOMAINS=cloud.{{ apps_domain }} {{ apps_bind }}
TRUSTED_PROXIES={{ apps_edge_proxies | join(' ') }}
OVERWRITEPROTOCOL=https
OVERWRITEHOST=cloud.{{ apps_domain }}
OVERWRITECLIURL=https://cloud.{{ apps_domain }}
PHP_MEMORY_LIMIT={{ nextcloud_php_memory_limit }}
PHP_UPLOAD_LIMIT={{ nextcloud_php_upload_limit }}
# Disable Apache's default 1 GiB LimitRequestBody so PHP_UPLOAD_LIMIT and the edge proxy govern uploads.
APACHE_BODY_LIMIT=0
TZ={{ apps_timezone }}
