#!/usr/sbin/nft -f
# Managed by ansible (bootstrap). Default-deny inbound; outbound unrestricted.
# Own table, replaced atomically: other tables (fail2ban, docker, ...) are left alone.
# The first `table` line makes the `delete` succeed on a first install (it is a no-op if the table exists).
# Terraform-generated service rules are IPv4-only on purpose.
{% set v4 = '^[0-9.]+(/[0-9]+)?$' %}
{% set mgmt4 = bootstrap_mgmt_cidrs | flatten | select('match', v4) | list %}
{% set mgmt6 = bootstrap_mgmt_cidrs | flatten | select('search', ':') | list %}
{% set mon4 = bootstrap_monitoring_cidrs | flatten | select('match', v4) | list %}
{% set mon6 = bootstrap_monitoring_cidrs | flatten | select('search', ':') | list %}
table inet bootstrap_fw
delete table inet bootstrap_fw

table inet bootstrap_fw {
  chain input {
    type filter hook input priority filter; policy drop;

    ct state invalid drop
    ct state established,related accept
    iifname "lo" accept
{% if bootstrap_firewall_trusted_ifaces | length > 0 %}
    # Trusted interfaces bypass ALL inbound filtering below (e.g. CNI interfaces on k3s nodes).
    iifname { {{ bootstrap_firewall_trusted_ifaces | map('to_json') | join(', ') }} } accept
{% endif %}

    ip protocol icmp icmp type { echo-request, destination-unreachable, time-exceeded } limit rate 10/second accept
    meta l4proto ipv6-icmp accept
    udp sport 67 udp dport 68 accept
    udp sport 547 udp dport 546 accept

{% if mgmt4 %}
    ip saddr { {{ mgmt4 | join(', ') }} } tcp dport 22 accept
{% endif %}
{% if mgmt6 %}
    ip6 saddr { {{ mgmt6 | join(', ') }} } tcp dport 22 accept
{% endif %}
{% if bootstrap_node_exporter_enabled | bool %}
{% if mon4 %}
    ip saddr { {{ mon4 | join(', ') }} } tcp dport {{ bootstrap_node_exporter_port }} accept
{% endif %}
{% if mon6 %}
    ip6 saddr { {{ mon6 | join(', ') }} } tcp dport {{ bootstrap_node_exporter_port }} accept
{% endif %}
{% endif %}
{% if bootstrap_ntp_serve_lan | bool and bootstrap_ntp_lan_cidr | length > 0 %}

    # NTP server for the LAN (time.yml, bootstrap_ntp_serve_lan)
    ip saddr { {{ bootstrap_ntp_lan_cidr }} } udp dport 123 accept
{% endif %}

    # Service rules generated by Terraform (guest_firewall_rules)
{% for r in bootstrap_firewall_extra_rules %}
    # {{ r.comment | default('extra rule') | replace('\n', ' ') }}
    ip saddr { {{ r.from | flatten | join(', ') }} } {{ r.proto }} dport {{ r.port }} accept
{% endfor %}
  }
}
