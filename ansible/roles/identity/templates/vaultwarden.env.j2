# {{ ansible_managed }}
DOMAIN=https://vault.{{ identity_domain }}
ROCKET_PORT={{ identity_vaultwarden_container_port }}
TZ={{ identity_timezone }}
LOG_LEVEL=warn

SIGNUPS_ALLOWED={{ vaultwarden_signups_allowed | bool | lower }}
SIGNUPS_VERIFY={{ vaultwarden_signups_verify | bool | lower }}
INVITATIONS_ALLOWED={{ vaultwarden_invitations_allowed | bool | lower }}
SENDS_ALLOWED={{ vaultwarden_sends_allowed | bool | lower }}
EMERGENCY_ACCESS_ALLOWED={{ vaultwarden_emergency_access_allowed | bool | lower }}
PASSWORD_HINTS_ALLOWED={{ vaultwarden_password_hints_allowed | bool | lower }}
SHOW_PASSWORD_HINT=false
{% if vaultwarden_org_creation_users | length > 0 %}
ORG_CREATION_USERS={{ vaultwarden_org_creation_users }}
{% endif %}

LOGIN_RATELIMIT_SECONDS={{ vaultwarden_login_ratelimit_seconds }}
LOGIN_RATELIMIT_MAX_BURST={{ vaultwarden_login_ratelimit_max_burst }}

# Outbound HTTP hardening
HTTP_REQUEST_BLOCK_NON_GLOBAL_IPS=true
{% if not (vaultwarden_icons_enabled | bool) %}
DISABLE_ICON_DOWNLOAD=true
ICON_CACHE_TTL=0
{% endif %}

# Only trust X-Real-IP from the edge proxy (rate limits key on this address).
{% if identity_allowed_sources | length > 0 %}
IP_HEADER=X-Real-IP
IP_HEADER_TRUSTED_PROXIES={{ identity_allowed_sources | join(',') }}
{% endif %}

{% if vaultwarden_smtp_host | length > 0 %}
SMTP_HOST={{ vaultwarden_smtp_host }}
SMTP_PORT={{ vaultwarden_smtp_port }}
SMTP_SECURITY={{ vaultwarden_smtp_security }}
SMTP_FROM={{ vaultwarden_smtp_from | quote }}
SMTP_FROM_NAME={{ vaultwarden_smtp_from_name | quote }}
REQUIRE_DEVICE_EMAIL={{ vaultwarden_require_device_email | bool | lower }}
{% if identity_vw_smtp_auth | bool %}
SMTP_USERNAME={{ vaultwarden_smtp_username | quote }}
SMTP_PASSWORD_FILE=/run/secrets/smtp_password
{% endif %}
{% endif %}

{% if vaultwarden_admin_token | length > 0 %}
ADMIN_TOKEN={{ vaultwarden_admin_token | quote }}
{% endif %}
