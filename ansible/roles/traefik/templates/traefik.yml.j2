
# {{ ansible_managed }}
# Static configuration (changes require a restart).

global:
  checkNewVersion: false
  sendAnonymousUsage: false

log:
  level: {{ traefik_log_level }}
  format: json

{% if traefik_access_log_enabled | bool %}
accessLog:
  format: json
  bufferingSize: 100
{% if traefik_access_log_status_codes | length > 0 %}
  filters:
    statusCodes: {{ traefik_access_log_status_codes | to_json }}
{% endif %}
{% endif %}

entryPoints:
  # HTTP: redirect to HTTPS.
  web:
    address: ":80"
    transport:
      lifeCycle:
        requestAcceptGraceTimeout: 5s
        graceTimeOut: 30s
    http:
      redirections:
        entryPoint:
          to: websecure
          scheme: https
          permanent: {{ (not (traefik_acme_staging | bool)) | to_json }}

  # HTTPS: default entrypoint for application routers.
  # Untrusted client-supplied X-Forwarded-* headers are not trusted.
  websecure:
    address: ":443"
    asDefault: true
    transport:
      lifeCycle:
        requestAcceptGraceTimeout: 5s
        graceTimeOut: 30s
    http:
      tls:
        certResolver: le
        domains:
          - main: "{{ traefik_domain }}"
            sans:
              - "*.{{ traefik_domain }}"

  # HTTP: loopback-only entrypoint for cloudflared.
  # No HTTPS redirect to avoid tunnel redirect loops.
  # Routers must explicitly opt in to this entrypoint.
  tunnel:
    address: "127.0.0.1:8081"
    transport:
      lifeCycle:
        requestAcceptGraceTimeout: 5s
        graceTimeOut: 30s
    forwardedHeaders:
      trustedIPs:
        - "127.0.0.1/32"

  # Internal Prometheus metrics and health checks.
  metrics:
    address: "{{ traefik_metrics_address }}"

ping:
  entryPoint: metrics

metrics:
  prometheus:
    entryPoint: metrics

providers:
  file:
    directory: /etc/traefik/dynamic
    watch: true

certificatesResolvers:
  le:
    acme:
      email: "{{ traefik_acme_email }}"
      keyType: EC256
{% if traefik_acme_staging | bool %}
      caServer: https://acme-staging-v02.api.letsencrypt.org/directory
      storage: /var/lib/traefik/acme-staging.json
{% else %}
      storage: /var/lib/traefik/acme.json
{% endif %}
      dnsChallenge:
        provider: cloudflare
        resolvers: {{ traefik_acme_resolvers | to_json }}
