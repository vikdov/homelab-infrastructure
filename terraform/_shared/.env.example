# .env.example
#
# Copy this file to .env (gitignored):
#   cp .env.example .env
#
# `task` loads .env automatically (see `dotenv:` in Taskfile.yml).
# To run Terraform by hand instead:
#   set -a; source .env; set +a
# or use direnv with `dotenv` in .envrc.
#
# IMPORTANT: never commit .env or real credentials to Git.
# Secrets here end up in Terraform state too; protect state accordingly.

# ---------------------------------------------------------------------------
# Proxmox API connection (all stages)
# ---------------------------------------------------------------------------

TF_VAR_proxmox_endpoint="https://192.168.1.x:8006"
# Fresh install: IP address or self-signed name.
# After ACME succeeds: https://<acme_domain>:8006

# Only while the API uses a self-signed certificate (first bootstrap run).
# Once the ACME certificate is installed: switch the endpoint above to the
# trusted domain name and remove this line (default is false).
#TF_VAR_proxmox_insecure=true

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------

# 00-bootstrap ONLY: root credentials (the service account does not exist yet).
#TF_VAR_proxmox_username="root@pam"   # default, can be omitted
#TF_VAR_proxmox_password="replace-me"

# Stages 01+ : API token created by bootstrap.
#   terraform -chdir=terraform/00-bootstrap output -json api_tokens
#PROXMOX_VE_API_TOKEN='terraform@pve!api=<secret>' # gitleaks:allow

# ---------------------------------------------------------------------------
# 00-bootstrap: ACME / trusted certificate (DuckDNS, DNS-01, no open ports)
# ---------------------------------------------------------------------------
# Take the ToS URL from the directory, it changes over time:
#   curl -s https://acme-v02.api.letsencrypt.org/directory | grep termsOfService
# Test against staging first, then switch to production (set as default in var,
# so just remove the TF_VAR_acme_directory after confirming):

#TF_VAR_acme_enabled=true
#TF_VAR_acme_domain="yoursubdomain.duckdns.org"
#TF_VAR_acme_contact="you@example.com"
#TF_VAR_acme_tos_url="<meta.termsOfService from the directory>"
#TF_VAR_acme_dns_api="duckdns"
#TF_VAR_acme_dns_data='{"DuckDNS_Token":"TOKEN-FROM-DUCKDNS"}'
#TF_VAR_acme_directory="https://acme-staging-v02.api.letsencrypt.org/directory"

# ---------------------------------------------------------------------------
# 02-workloads
# ---------------------------------------------------------------------------

# Addresses allowed to SSH to every guest, AS THE GUEST SEES THEM
# (your workstation's LAN address; vnet gateways are added automatically).
#TF_VAR_mgmt_cidrs='["192.168.1.x/32"]'
#TF_VAR_lan_cidr="192.168.1.0/24"
#TF_VAR_global_ssh_keys='["ssh-ed25519 AAAA... your-homelab-key"]'

# Datacenter firewall. Stage the rollout: apply with false, review in the UI,
# then apply with true.
#TF_VAR_firewall_activate=true

# Keep ACCEPT until you have confirmed mgmt_cidrs covers this machine.
# DROP without a correct mgmt_cidrs locks you out of SSH and the web UI.
#TF_VAR_host_firewall_input_policy="ACCEPT"

# ---------------------------------------------------------------------------
# 03-backups (only after Ansible has configured PBS)
# ---------------------------------------------------------------------------
# Secret printed once by `proxmox-backup-manager user generate-token`.
#TF_VAR_pbs_token_secret="replace-me"
# From `proxmox-backup-manager cert info` on the PBS guest.
#TF_VAR_pbs_fingerprint="AA:BB:...:FF"
#TF_VAR_pbs_datastore="main"
# Optional client-side encryption key (JSON). Keep an offline copy: losing it
# makes every encrypted backup unrecoverable.
#TF_VAR_pbs_encryption_key='{"kdf":...}'
