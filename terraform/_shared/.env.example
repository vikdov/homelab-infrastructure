# .env.example
#
# Copy this file to .env:
#   cp .env.example .env
#
# Load it into your shell:
#   set -a; source .env; set +a
#
# Or use direnv with:
#   dotenv
# in .envrc
#
# IMPORTANT: Never commit .env or real credentials to Git.

# ---------------------------------------------------------------------------
# Proxmox Provider - Connection
# ---------------------------------------------------------------------------

TF_VAR_proxmox_endpoint="https://192.168.1.254:8006"

# Set to true only if the Proxmox API uses a self-signed or otherwise
# untrusted TLS certificate.
TF_VAR_proxmox_insecure=true

# ---------------------------------------------------------------------------
# Proxmox Provider - Authentication
# ---------------------------------------------------------------------------

# Option 1: Username/password
#
# Intended for initial bootstrap only. Prefer an API token for normal
# Terraform operation.
#
# TF_VAR_proxmox_username="root@pam"  #Can omit, this default already in code
# TF_VAR_proxmox_password="replace-me"

# Option 2: API token (preferred for normal operation)
# After bootstrap, retrieve the generated token with:
#   terraform output -json api_tokens
# Example format:
#   export PROXMOX_VE_API_TOKEN='terraform@pve!api=<secret>' # gitleaks:allow
#
# Keep the real token secret and never commit it to Git.

# ----------------------------------------------------------------------------
# Other Terraform Variables
# ----------------------------------------------------------------------------

# use TF_VAR_* syntax to set Terraform variables.
# TF_VAR_global_ssh_keys='["ssh-ed25519 AAAA..."]'
